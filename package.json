{
  "name": "cli-table3",
  "version": "1.0.0",
  "description": "Pretty unicode tables for the command line. Based on the original cli-table.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "ansis": "4.5.0",
    "string-width": "^4.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "cli-table": "^0.3.1",
    "lerna-changelog": "^1.0.1",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "clean": "node -e \"for (const d of ['dist', '.cache', 'coverage']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "prepack": "pnpm clean && pnpm build",
    "changelog": "lerna-changelog",
    "docs:generate": "pnpm build && node scripts/update-docs.mts",
    "docs:check": "pnpm docs:generate && git diff --exit-code -- basic-usage.md advanced-usage.md",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "typecheck": "pnpm build && tsc -p tsconfig.json",
    "test": "vitest run --coverage && pnpm typecheck && pnpm lint",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack .",
    "examples": "pnpm build && node scripts/print-examples.mts",
    "smoke": "node scripts/smoke-test.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cli-table/cli-table3.git"
  },
  "keywords": [
    "node",
    "command",
    "line",
    "cli",
    "table",
    "tables",
    "tabular",
    "unicode",
    "colors",
    "grid"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cli-table/cli-table3/issues"
  },
  "homepage": "https://github.com/cli-table/cli-table3",
  "engines": {
    "node": ">=22.12"
  },
  "changelog": {
    "repo": "cli-table/cli-table3",
    "labels": {
      "breaking": ":boom: Breaking Change",
      "enhancement": ":rocket: Enhancement",
      "bug": ":bug: Bug Fix",
      "documentation": ":memo: Documentation",
      "internal": ":house: Internal"
    }
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "cli-table>colors": "npm:@colors/colors@1.5.0"
    }
  },
  "type": "commonjs"
}
